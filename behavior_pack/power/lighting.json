{
  "schema_version": 1,
  "status": "design_only",
  "powered": true,
  "modes": [
    "always_on",
    "always_off",
    "night",
    "day",
    "motion",
    "redstone",
    "power_available"
  ],
  "default_mode": "always_on",
  "power_loss_behavior": "turn_off_and_restore_selected_mode_when_power_returns",
  "sensors": {
    "motion_sensor": {
      "powered": true,
      "configurable_range": true
    },
    "light_sensor": {
      "powered": true,
      "configurable_threshold": true
    }
  },
  "groups": {
    "supported": true,
    "examples": [
      "factory",
      "home",
      "perimeter"
    ],
    "preserve_individual_modes_unless_explicitly_overridden": true
  }
}